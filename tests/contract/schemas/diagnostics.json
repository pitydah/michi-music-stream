{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Michi Music Stream receiver diagnostics",
    "description": "GET /api/v1/receiver/diagnostics (Bearer STATUS) - firmware-only endpoint. Shape mirrors diagnostics_get_handler in firmware/components/michi_http/http_server.c; no example file exists, the contract tests validate the schema against a fixture with that exact shape.",
    "type": "object",
    "required": [
        "uptime_seconds", "heap_free", "heap_min_free", "psram_free",
        "psram_size", "reset_reason", "wifi", "audio", "dac", "session",
        "last_error", "firmware", "ota"
    ],
    "additionalProperties": true,
    "properties": {
        "uptime_seconds": {"type": "integer", "minimum": 0},
        "heap_free": {"type": "integer", "minimum": 0},
        "heap_min_free": {"type": "integer", "minimum": 0},
        "psram_free": {"type": "integer", "minimum": 0},
        "psram_size": {"type": "integer", "minimum": 0},
        "reset_reason": {"type": "string"},
        "i2s_errors": {"type": "integer", "minimum": 0},
        "wifi": {
            "type": "object",
            "required": ["connected", "ssid"],
            "properties": {
                "connected": {"type": "boolean"},
                "ssid": {"type": "string"},
                "rssi_dbm": {"type": "integer"},
                "reconnects": {"type": "integer", "minimum": 0}
            }
        },
        "audio": {
            "type": "object",
            "required": [
                "session_active", "received", "lost", "late", "duplicate",
                "reordered", "underruns", "overruns", "drops_malformed",
                "drops_pt_s24le", "drops_pt_other", "drops_ssrc_filtered",
                "drops_payload_geometry", "jitter_us", "buffer_ms",
                "packets_in_buffer", "last_seq", "last_timestamp"
            ],
            "properties": {
                "session_active": {"type": "boolean"},
                "ssrc": {"type": "integer", "minimum": 0},
                "received": {"type": "integer", "minimum": 0},
                "lost": {"type": "integer", "minimum": 0},
                "late": {"type": "integer", "minimum": 0},
                "duplicate": {"type": "integer", "minimum": 0},
                "reordered": {"type": "integer", "minimum": 0},
                "underruns": {"type": "integer", "minimum": 0},
                "overruns": {"type": "integer", "minimum": 0},
                "drops_malformed": {"type": "integer", "minimum": 0},
                "drops_pt_s24le": {"type": "integer", "minimum": 0},
                "drops_pt_other": {"type": "integer", "minimum": 0},
                "drops_ssrc_filtered": {"type": "integer", "minimum": 0},
                "drops_payload_geometry": {"type": "integer", "minimum": 0},
                "jitter_us": {"type": "integer", "minimum": 0},
                "buffer_ms": {"type": "integer", "minimum": 0},
                "packets_in_buffer": {"type": "integer", "minimum": 0},
                "last_seq": {"type": "integer", "minimum": 0},
                "last_timestamp": {"type": "integer", "minimum": 0}
            }
        },
        "dac": {
            "type": "object",
            "required": ["detected", "initialized", "model", "tier", "sample_rate", "bit_depth"],
            "properties": {
                "detected": {"type": "boolean"},
                "initialized": {"type": "boolean"},
                "model": {"type": "string"},
                "tier": {"type": "string"},
                "sample_rate": {"type": "integer", "minimum": 0},
                "bit_depth": {"type": "integer", "minimum": 0}
            }
        },
        "session": {
            "type": "object",
            "required": ["active"],
            "properties": {
                "active": {"type": "boolean"},
                "session_id": {"type": "string"},
                "codec": {"type": "string"},
                "sample_rate": {"type": "integer", "minimum": 0},
                "bit_depth": {"type": "integer", "minimum": 0},
                "channels": {"type": "integer", "minimum": 0},
                "stream_port": {"type": "integer", "minimum": 0},
                "buffer_ms": {"type": "integer", "minimum": 0},
                "volume": {"type": "integer", "minimum": 0},
                "paused": {"type": "boolean"},
                "ssrc": {"type": "integer", "minimum": 0},
                "source_addr": {"type": "string"}
            }
        },
        "last_error": {
            "type": "object",
            "required": ["event", "data", "target"],
            "properties": {
                "event": {"type": ["string", "null"]},
                "data": {"type": "integer"},
                "target": {
                    "$comment": "'unknown' is reserved and must never be emitted: the handler maps the unreachable default state to 'none' (see last_error_target_name in http_server.c).",
                    "type": "string",
                    "enum": ["recoverable", "fatal", "none"]
                }
            }
        },
        "firmware": {
            "type": "object",
            "required": ["version", "build_date", "board"],
            "properties": {
                "version": {"type": "string"},
                "build_date": {"type": "string"},
                "board": {"type": "string"}
            }
        },
        "ota": {
            "type": "object",
            "required": ["state", "percent"],
            "properties": {
                "state": {"type": "string"},
                "percent": {"type": "integer", "minimum": 0, "maximum": 100},
                "error": {"type": "string"}
            }
        }
    }
}
