menu "Michi Music Stream Audio Engine"

    comment "RTP/UDP session engine (MS-07): canonical PCM S16LE 48 kHz stereo (PT 97, 1920-byte payloads), packet jitter buffer, metrics. Non-canonical formats (S24LE, Opus, other PTs) are rejected and counted, never accepted."

    config MICHI_AUDIO_RTP_PT_S16LE
        int "RTP payload type for PCM S16LE"
        default 97
        range 97 97
        help
          Canonical RTP payload type (contract section 2.5): 97.
          The range pins the value to 97 so a stale sdkconfig can
          never build a device that accepts another PT; michi_audio
          init additionally verifies the constant against the code.

    config MICHI_AUDIO_JITTER_MAX_MS
        int "Jitter buffer capacity (ms)"
        default 500
        range 50 2000
        help
          Packet-level jitter buffer capacity, expressed in 10 ms
          packets (500 ms = 50 packets). The per-session payload pool is
          capacity x MICHI_AUDIO_RX_BUF_BYTES in PSRAM, so 500 ms/8192 B
          costs ~400 KB. Larger values absorb longer network stalls at
          the cost of PSRAM and startup latency.

    config MICHI_AUDIO_PREFILL_MS
        int "Jitter buffer prefill before playback (ms)"
        default 80
        range 10 1000
        help
          Audio buffered into the jitter buffer before the session
          starts writing to the pipeline (clamped at runtime to
          MICHI_AUDIO_JITTER_MAX_MS). After every underrun a fixed
          re-prefill of 250 ms (MICHI_AUDIO_REPREFILL_MS) is used,
          independent of this value.

    config MICHI_AUDIO_RX_BUF_BYTES
        int "Session UDP receive buffer size (bytes)"
        default 8192
        range 2048 65535
        help
          Size of the datagram buffer and of each jitter-buffer payload
          slot. Must exceed the canonical 12-byte RTP header + 1920-byte
          payload (michi_audio init verifies it). Datagrams larger than
          this are truncated by recvfrom.

    config MICHI_AUDIO_TASK_STACK_BYTES
        int "Session task stack size (bytes)"
        default 6144
        range 4096 32768
        help
          Stack of the per-session task (socket I/O, RTP parse, jitter
          buffer insert, blocking pipeline writes). The datagram and
          silence buffers live on the heap, not the stack.

endmenu
